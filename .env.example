# Configurações do Sistema NeuroLearn - Template
# Copie este arquivo para .env e preencha com suas configurações reais

# Chave secreta do Flask (gere uma chave forte)
SECRET_KEY=insira_aqui_uma_chave_secreta_forte

# IA local por padrao para reduzir risco de vazamento de dados sensiveis.
# Recomendado: instale/inicie Ollama e baixe um modelo instruction-tuned.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_TIMEOUT=180

# Opcional: somente se voce mudar AI_PROVIDER=gemini.
GEMINI_API_KEY=

# Configurações do Banco de Dados
DATABASE_URL=sqlite:///sistema_educacional.db

# Configurações de Debug (sempre False em produção)
FLASK_DEBUG=False
FLASK_ENV=production

# Configurações de Segurança
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Rate Limiting
RATE_LIMIT_STORAGE_URL=memory://

